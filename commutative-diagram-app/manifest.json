{
  "manifestVersion": 2,
  "id": "commutative-diagram",
  "name": "交换图画布",
  "version": "1.5.2",
  "entry": "index.js",
  "icon": "ui/assets/cover.svg",
  "description": "离线可视化绘制交换图，支持节点、弯箭头、自环、LaTeX snippets 和 tikz-cd 源码双向编辑。Ctrl+Q 删除选中对象。",
  "minAppVersion": "0.1013.0",
  "capabilities": ["app/tools.expose-to-model", "app/windows.manage", "app/ui.clipboard-write"],
  "contributes": {
    "cards": [{
      "id": "editor",
      "title": "交换图画布",
      "description": "可视化编辑交换图并导出 tikz-cd 代码",
      "route": "/editor.html",
      "cardForm": "flush",
      "titlebar": "translucent",
      "realization": "page",
      "siteNavEntry": true,
      "face": {"image":"assets/cover.svg"}
    }]
  }
}
